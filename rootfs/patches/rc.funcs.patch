# Plugin runner: switch plugin through one swbatch process, persistent hooks in /etc/persistent/hooks,
# UDAPI plugins not started, es5xp-qos started in the background.
--- a/usr/etc/rc.d/rc.funcs
+++ b/usr/etc/rc.d/rc.funcs
@@ -1,7 +1,32 @@
+# es5xp: switch plugin - all its swconfig calls are done by one /bin/swbatch process: during plugin_start
+# swconfig is a shell function that writes its arguments to a file with the builtin printf (no processes are
+# started), then one swbatch runs them. Exit code 0 - done, 1 - some lines failed (as with swconfig, messages on
+# the console); otherwise (2 - nothing written; >=126 - did not start or crashed) plugin_start runs again with
+# the vendor swconfig (a full apply is idempotent).
+# Flag file /etc/persistent/es5xp-no-swbatch: always the vendor swconfig.
+es5xp_swbatch_start() {
+	local f=/tmp/.swbatch.$$ rc
+	true > $f || { plugin_start; return; }       # not ":" - a redirection error of a special builtin exits the shell
+	swconfig() { printf '%s\037' "$@" >&9; echo >&9; }
+	plugin_start 9>>$f
+	unset -f swconfig
+	/bin/swbatch < $f
+	rc=$?
+	rm -f $f
+	case $rc in
+		0|1) ;;
+		*) echo "swbatch: rc=$rc, plugin switch via vendor swconfig"; plugin_start ;;
+	esac
+}
+
 run_plugin() {
 	. /etc/sysinit/$1.conf
 	case "$2" in
 		start)
-		plugin_start
+		if [ "$1" = switch ] && [ -x /bin/swbatch ] && [ ! -e /etc/persistent/es5xp-no-swbatch ]; then
+			es5xp_swbatch_start
+		else
+			plugin_start
+		fi
 		;;
 		stop)
@@ -47,15 +72,18 @@
 
 rc_start() {
-	if [ -f /etc/prestart ]; then
-		echo #. /etc/persistent/rc.prestart
+	if [ -f /etc/persistent/hooks/prestart ]; then
+		. /etc/persistent/hooks/prestart
 	fi
-	startuplist=`grep -v '#' ${STARTUP_LIST}`
+	# es5xp: unms and udapi_bridge (UDAPI leftovers generated by ubntconf) are not started; core_pattern: rc.sysinit
+	startuplist=`grep -v -e '#' -e '^unms$' -e '^udapi_bridge$' ${STARTUP_LIST}`
 
 	run_plugins start $startuplist
+	# es5xp: switch priorities from the qos.* keys, in the background (does not delay the start); -f: full ASIC check
+	setsid /bin/es5xp-qos -l /tmp/es5xp-qos.log -f apply < /dev/null > /dev/null 2>&1 &
 
 	/sbin/bgnd -r garp -- /sbin/garp -s 2 &
 
-	if [ -f /etc/poststart ]; then
-		echo #. /etc/persistent/rc.poststart
+	if [ -f /etc/persistent/hooks/poststart ]; then
+		. /etc/persistent/hooks/poststart
 	fi
         log_msg system Start
@@ -64,9 +92,10 @@
 rc_stop() {
         log_msg system Stop
-	if [ -f /etc/prestop ]; then
-		echo #. /etc/persistent/rc.prestop
+	if [ -f /etc/persistent/hooks/prestop ]; then
+		. /etc/persistent/hooks/prestop
 	fi
 
-	origlist=`grep -v '#' ${STARTUP_LIST}`
+	# es5xp: unms and udapi_bridge are not stopped - rc_start does not start them
+	origlist=`grep -v -e '#' -e '^unms$' -e '^udapi_bridge$' ${STARTUP_LIST}`
 	startuplist=""
 	for a in ${origlist}; do 
@@ -76,6 +105,6 @@
 	run_plugins stop $startuplist
 
-	if [ -f /etc/poststop ]; then
-		echo #. /etc/persistent/rc.poststop
+	if [ -f /etc/persistent/hooks/poststop ]; then
+		. /etc/persistent/hooks/poststop
 	fi
 }
